# MIME Types for favicons
<IfModule mod_mime.c>
 AddType image/x-icon .ico
 AddType image/png .png
 AddType image/svg+xml .svg
 AddType application/manifest+json .webmanifest
 AddType application/xml .xml
</IfModule>

# Prefer www (Apache / DigitalOcean). GitHub Pages uses CNAME + DNS instead.
<IfModule mod_rewrite.c>
 RewriteEngine On
 RewriteCond %{HTTPS} !=on
 RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
 RewriteCond %{HTTP_HOST} ^discernible\.io$ [NC]
 RewriteRule ^ https://www.discernible.io%{REQUEST_URI} [L,R=301]
 RewriteRule ^developers\.html$ /developers/ [L,R=301]
 RewriteRule ^get-started\.html$ /get-started/ [L,R=301]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
 # Prevent clickjacking
 Header always set X-Frame-Options "SAMEORIGIN"

 # Prevent MIME type sniffing
 Header always set X-Content-Type-Options "nosniff"

 # Referrer Policy
 Header always set Referrer-Policy "strict-origin-when-cross-origin"

 # Content Security Policy (adjust as needed)
 Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://code.jquery.com https://s3.amazonaws.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.identyclaw.com; frame-ancestors 'self';"
</IfModule>

# Production cache (GitHub Pages ignores .htaccess; used on Apache / DO)
<IfModule mod_headers.c>
 <FilesMatch "\.(html|htm)$">
 Header set Cache-Control "public, max-age=3600, must-revalidate"
 </FilesMatch>

 <FilesMatch "\.(css|js)$">
 Header set Cache-Control "public, max-age=2592000, must-revalidate"
 </FilesMatch>

 <FilesMatch "\.(jpg|jpeg|png|gif|svg|webp|ico|woff2?)$">
 Header set Cache-Control "public, max-age=31536000, immutable"
 </FilesMatch>
</IfModule>

# Enable ETag for better cache validation
FileETag MTime Size

# Protect sensitive files (but allow .nojekyll for GitHub Pages and .htaccess)
<FilesMatch "^\.((?!nojekyll|htaccess).)*$">
 Require all denied
</FilesMatch>

# Explicitly allow favicon and manifest files
<FilesMatch "^(favicon\.ico|.*\.png|.*\.webmanifest|browserconfig\.xml)$">
 Require all granted
</FilesMatch>

# Prevent access to backup and config files
<FilesMatch "\.(bak|config|sql|fla|psd|ini|log|sh|inc|swp|dist)$">
 Require all denied
</FilesMatch>
